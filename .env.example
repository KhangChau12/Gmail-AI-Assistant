# ─── Gmail ────────────────────────────────────────────────────────────────
# Your Gmail address and a 16-character App Password (NOT your normal password).
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ─── AI ───────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API works. For OpenAI, get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: model used for triage, chat and drafting.
OPENAI_MODEL=gpt-4o-mini
# Optional: point at another OpenAI-compatible server (e.g. Ollama: http://localhost:11434/v1)
# OPENAI_BASE_URL=

# ─── You ──────────────────────────────────────────────────────────────────
# Optional: your first name for the greeting, and the starting language (vi or en).
YOUR_NAME=
APP_LANGUAGE=vi

# ─── Sync ─────────────────────────────────────────────────────────────────
# How many of the newest inbox messages to import on the very first sync.
SYNC_INITIAL_LIMIT=200
# Where the local SQLite database lives (relative to the project root).
# DATABASE_PATH=data/inbox.db
